---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">
    A professional camera, built for your pocket.
  </h1>
  <p class="mt-4 text-neutral-600 dark:text-neutral-400">
    Manual controls, real-time color grading, and cinematic shooting modes
    for iPhone. Built with SwiftUI, AVFoundation, and Core Image.
  </p>
  <div class="mt-8 flex gap-4">
    <a
      href="/privacy"
      class="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white dark:bg-white dark:text-neutral-900"
    >
      Privacy Policy
    </a>
    <a
      href="/support"
      class="rounded-full border border-neutral-300 px-5 py-2.5 text-sm font-medium dark:border-neutral-700"
    >
      Support
    </a>
  </div>
</Layout>
